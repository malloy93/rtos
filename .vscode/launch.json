{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RTOS: Debug STM32F429I-DISC1",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/firmware-debug/rrtos_f429_core.elf",
            "device": "STM32F429ZI",
            "configFiles": [
                "${workspaceFolder}/openocd/stm32f429i-disc1.cfg"
            ],
            "gdbPath": "/usr/bin/gdb-multiarch",
            "preLaunchTask": "RTOS: Build firmware",
            "runToEntryPoint": "main"
        }
    ]
}
